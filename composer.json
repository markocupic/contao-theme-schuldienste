{
    "name": "markocupic/contao-schuldienste-theme",
    "description": "Das Contao Theme für www.schuldienste.ch",
    "keywords": [
        "contao",
        "bundle",
        "theme",
        "schuldienste.ch"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/contao-schuldienste-theme/issues",
        "source": "https://github.com/markocupic/contao-schuldienste-theme"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "markocupic/composer-file-copier-plugin": "^0.2",
        "markocupic/contao-component-fontawesome-free": "7.0.0",
        "inspiredminds/contao-glightbox": "^1.0",
        "inspiredminds/contao-s"
    },
    "require-dev": {
        "symfony/webpack-encore-bundle": "v2.2.0",
        "contao/manager-plugin": "^2.12",
        "markocupic/easy-coding-standard": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\ContaoSchuldiensteTheme\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "contao-community-alliance/composer-plugin": true
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\ContaoSchuldiensteTheme\\ContaoManager\\Plugin",
        "composer-file-copier-plugin": [
            {
                "source": "contao/templates/rocksolid",
                "target": "templates/schuldienste",
                "options": {
                    "OVERRIDE": true
                }
            },
            {
                "source": "files",
                "target": "files",
                "options": {
                    "OVERRIDE": true
                }
            }
        ]
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check config/ contao/ src/ templates/ tests/ --config tools/ecs/config.php --fix --ansi",
        "unit-tests": "@php tools/phpunit/vendor/bin/phpunit -c tools/phpunit/phpunit.xml.dist"
    },
    "version": "3.0"
}


