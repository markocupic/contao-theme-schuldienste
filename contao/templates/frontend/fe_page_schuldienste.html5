<!DOCTYPE html>
<html lang="<?= $this->language ?>"<?php if ($this->isRTL): ?> dir="rtl"<?php endif; ?>>
  <head>

    <?php $this->block('head'); ?>
      <meta charset="<?= $this->charset ?>">
      <title><?= $this->title ?></title>
      <base href="<?= $this->base ?>">

      <?php $this->block('meta'); ?>
        <meta name="robots" content="<?= $this->robots ?>">
        <meta name="description" content="<?= $this->description ?>">
        <meta name="generator" content="Contao Open Source CMS">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <?php $this->endblock(); ?>

      <!-- Custom fonts for this template -->
      <link rel="stylesheet" href="assets/contao-component-fontawesome-free/fontawesomefree/css/fontawesome.min.css">
      <link rel="stylesheet" href="assets/contao-component-fontawesome-free/fontawesomefree/css/all.min.css">

      <script src="assets/contao-component-fontawesome-free/fontawesomefree/js/all.min.js"></script>
      <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,400i,600,600i,700,700i,800,800i" rel="stylesheet">

    <?= $this->viewport ?>
      <?= $this->framework ?>
      <?= $this->stylesheets ?>
      <?= $this->mooScripts ?>
      <script src="{{asset::js/theme.js::markocupic_contao_schuldienste_theme}}"></script>
      <link rel="stylesheet" href="{{asset::styles/frontend.css::markocupic_contao_schuldienste_theme}}">
      <?= $this->head ?>
    <?php $this->endblock(); ?>

  </head>
  <body id="top" class="{{ua::class}}<?php if ($this->class) echo ' ' . $this->class; ?>"<?php if ($this->onload): ?> onload="<?= $this->onload ?>"<?php endif; ?> itemscope itemtype="http://schema.org/WebPage">


    <?php $this->block('body'); ?>
      <?php if(!empty($this->sections['sidebar_section'])): ?>
				<div id="sidebar">
					<?= $this->sections['sidebar_section'] ?>
				</div>
				<?php endif; ?>
      <?php $this->sections('top'); ?>

      <div id="wrapper">
        <?php $this->block('header'); ?>
          <?php if ($this->header): ?>
            <header id="header">
              <div class="inside">
                <?= $this->header ?>
              </div>
            </header>
          <?php endif; ?>
        <?php $this->endblock(); ?>

        <?php if(!empty($this->sections['post_header'])): ?>
            <div id="postHeader">
              <div class="container-lg p-0">
                <?= $this->sections['post_header'] ?>
              </div>
            </div>
        <?php endif; ?>

        <?php $this->sections('before'); ?>

        <?php $this->block('container'); ?>
          <div id="container" class="d-flex flex-column">
            <div class="container-inner">
              <?php $this->block('main'); ?>
	              <main id="main">
	                <div class="inside">
	                  <?= $this->main ?>
	                </div>
	                <?php $this->sections('main'); ?>
	              </main>
	            <?php $this->endblock(); ?>
            </div> <!-- end container inner -->
          </div> <!-- end container -->
        <?php $this->endblock(); ?>

        <?php $this->block('footer'); ?>
        <?php if ($this->footer): ?>
        <footer id="footer" class="container-lg d-flex flex-column">
          <div class="inside">
            <?= $this->footer ?>
          </div>
        </footer>
        <?php endif; ?>
        <?php $this->endblock(); ?>

        <?php $this->sections('after'); ?>

      </div><!-- end wrapper -->

      <?php $this->sections('bottom'); ?>
    <?php $this->endblock(); ?>

    <!-- Bootstrap core JavaScript -->
    <script src="{{asset::bootstrap/dist/js/bootstrap.bundle.min.js::markocupic_contao_schuldienste_theme}}"></script>,

    <?= $this->mootools ?>
    <?= $this->jsonLdScripts ?>
  </body>
</html>
