{# Set wrapper attributes #}
{% set wrapperAttributes = attrs()
    .addClass([class|default(''), 'block'])
    .addClass('container-lg')
    .addClass('d-none d-sm-block mt-2 mb-2')
    .addStyle(style|default(''))
    .set('aria-label', 'MSC.breadcrumbMenu'|trans)
    .mergeWith(wrapperAttributes|default) %}
<!-- indexer::stop -->
<nav{{ cssID|raw }}{{ wrapperAttributes }}>
    {% block headline %}
        {% if headline %}
            <{{ hl }}>{{ headline }}</{{ hl }}>
        {% endif %}
    {% endblock %}
    {% block content %}
        <ul class="m-0">
            {% for item in items %}
                {% if item.isActive %}
                    {% if loop.index0 == 0 %}
                        <li class="active" aria-current="page"><i class="fa-solid fa-home me-2"></i>{{ item.title|raw }}</li>
                    {% else %}
                        <li class="active" aria-current="page">{{ item.title|raw }}</li>
                    {% endif %}
                {% else %}
                    {% if loop.index0 == 0 %}
                        <li><a href="{{ item.href }}"><i class="fa-solid fa-home me-2"></i> {{ item.title|raw }}</a></li>
                    {% else %}
                        <li><a href="{{ item.href }}">{{ item.title|raw }}</a></li>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </ul>
    {% endblock %}
</nav>
<!-- indexer::continue -->
{% do add_schema_org(getSchemaOrgData.invoke()) %}
