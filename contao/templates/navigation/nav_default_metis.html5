
<ul<?php if($this->level === 'level_1'): ?> id="metismenu"<?php endif; ?> class="<?= $this->level ?>">
  <?php foreach ($this->items as $item): ?>
    <?php $blnAriaExpanded = ((strpos($item['class'], 'trail') || ($item['isActive'] && !empty($item['subitems']))) && $this->level === 'level_1') ? 'true' : 'false'; ?>

<?php if($this->level === 'level_1' && !empty($item['subitems'])): ?>
<?php $item['class'] = $item['class'] == '' ? 'has-arrow' : $item['class'] . ' has-arrow'; ?>
<?php endif; ?>

    <?php if ($item['isActive']): ?>
      <?php if($blnAriaExpanded): ?>
        <?php $item['class'] = $item['class'] == '' ? 'mm-active' : $item['class'] . ' mm-active'; ?>
      <?php endif; ?>
      <li class="<?= $item['class'] ?>"><a href="#" class="has-arrow <?= $item['class'] ?>"<?php if (!empty($item['subitems'])) echo ' aria-haspopup="true"'; ?> aria-expanded="<?= $blnAriaExpanded ?>" itemprop="name"><?= $item['link'] ?></a><?= $item['subitems'] ?></li>
    <?php else: ?>

      <li<?php if ($item['class']) echo ' class="' . $item['class'] . '"'; ?>><a href="<?= $item['href'] ?: './' ?>" title="<?= $item['pageTitle'] ?: $item['title'] ?>"<?php if ($item['class']) echo ' class="' . $item['class'] . '"'; ?><?php if ($item['accesskey'] !== '') echo ' accesskey="' . $item['accesskey'] . '"'; ?><?php if ($item['tabindex']) echo ' tabindex="' . $item['tabindex'] . '"'; ?><?= $item['target'] ?><?= $item['rel'] ?><?php if (!empty($item['subitems'])) echo ' aria-haspopup="true"'; ?> aria-expanded="<?= $blnAriaExpanded ?>" itemprop="url"><span itemprop="name"><?= $item['link'] ?></span></a><?= $item['subitems'] ?></li>
    <?php endif; ?>
  <?php endforeach; ?>
</ul>
