{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}
    <ul class="list-unstyled row g-3">
        {% for card in cards %}
            <li class="col-12 col-sm-6 col-md-4">
                <div class="card">
                    <div class="card-body">
                        <address class="mb-3">
                            {% if card.name|default %}
                                <div class="card-title mb-3">{% if card.href|default %}<a href="{{ card.url }}">{% endif %}<strong>{{ card.name }}</strong>{% if card.href|default %}</a>{% endif %}</div>
                            {% endif %}
                            {% if card.function|default %}
                                <div class="text-muted mb-2 text-body-secondary">{{ card.function }}</div>
                            {% endif %}
                            {% if card.street|default %}
                                <div>{{ card.street }}</div>
                            {% endif %}
                            <div>{{ card.postal|default }} {{ card.city|default }}</div>
                            {% if card.phone|default %}
                                <div><a class="card-link" href="tel:{{ card.phone|replace([' ', '']) }}">{{ card.phone }}</a></div>
                            {% endif %}
                            {% if card.email|default %}
                                <div>{{ insert_tag('email::'~card.email)|raw }}</div>
                            {% endif %}
                        </address>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
