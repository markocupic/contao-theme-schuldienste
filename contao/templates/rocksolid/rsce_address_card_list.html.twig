{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}
    {% if slide %}
        {% embed "@MarkocupicContaoSchuldiensteTheme/component/frontend/mcslider_wrapper_element.html.twig" %}
            {% block mcslider_slides %}
                <ul class="mcglide__slides list-unstyled">
                    {% for card in cards %}
                        <li class="mcglide__slide">
                            {% include "@MarkocupicContaoSchuldiensteTheme/component/frontend/address_card_component.html.twig" with card %}
                        </li>
                    {% endfor %}
                </ul>
            {% endblock %}
        {% endembed %}
    {% else %}
        <ul class="list-unstyled row g-3">
            {% for card in cards %}
                <li class="col-12 col-sm-6 col-md-4">
                    {% include "@MarkocupicContaoSchuldiensteTheme/component/frontend/address_card_component.html.twig" with card %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
