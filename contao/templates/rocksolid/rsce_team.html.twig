<div class="{{ class }} block"{{ cssID|raw }}>
    <{{ hl }}>{{ headline }}</{{ hl }}>
    <div class="grid">
        {% if app.request.attributes.get('_scope') == 'frontend' %}
            {% for member in members %}
                <div class="g-col-6 g-col-md-2 g-col-lg-3 mb-5">
                    {% if member.image|default %}
                        {{ insert_tag('picture::'~member.image~'?size=3&class=img-fluid rounded-circle w-100&alt='~member.name)|raw }}
                    {% endif %}
                </div>
                <div class="g-col-6 g-col-md-4 g-col-lg-3 mb-5">
                    {% if member.name|default %}
                        <h4 class="mt-0 text-primary">{{ member.name }}</h4>
                    {% endif %}
                    {% if member.function|default %}
                        <div class="team-member-function">
                            <strong>{{ member.function }}</strong>
                        </div>
                    {% endif %}
                    <div class="team-member-description">
                        {{ member.description|raw|nl2br }}
                    </div>
                    {% if member.email or member.phone %}
                        <address>
                            {% if member.email %}
                                <div class="team-member-email">
                                    {{ insert_tag('email_open::'~member.email)|raw }}E-Mail</a>
                                </div>
                            {% endif %}
                            {% if member.phone %}
                                <div class="team-member-phone">
                                    <a href="tel:{{ member.phone }}">{{ member.phone }}</a>
                                </div>
                            {% endif %}
                        </address>
                    {% endif %}
                </div>
            {% endfor %}
        {% endif %}
        {% if app.request.attributes.get('_scope') == 'backend' %}
            {% for member in members %}
                {% if member.name|default %}
                    <h4 class="mt-0 text-primary">{{ member.name }}</h4>
                {% endif %}
                {% if member.image|default %}
                    <div style="margin-bottom: 15px;">
                        {{ insert_tag("image::" ~ member.image ~ "?width=100&height=100&method=crop")|raw }}
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div><!-- end row -->
</div>
