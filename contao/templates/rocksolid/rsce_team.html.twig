<div class="{{ class }} block"{{ cssID }}>
    <{{ hl }}>{{ headline }}</{{ hl }}>
    <div class="row">
        {% if app.request.attributes.get('_scope') == 'frontend' %}
            {% for member in members %}
                <div class="col-6 col-md-2 col-lg-3 mb-5">
                    {% if member.image|default %}
                        {{ insert_tag('picture::'~member.image~'?size=1&class=img-fluid w-100&alt='~member.name)|raw }}
                    {% endif %}
                </div>
                <div class="col-6 col-md-4 col-lg-3 mb-5">
                    {% if member.name|default %}
                        <h4 class="mt-0 text-primary">{{ member.name }}</h4>
                    {% endif %}
                    {% if member.function|default %}
                        <div class="team-member-function">
                            <strong>{{ member.function }}</strong>
                        </div>
                    {% endif %}
                    <div class="team-member-description">
                        {{ member.description|raw|nl2br }}
                    </div>
                    <div class="team-member-email">
                        {{ insert_tag('email_open::'~member.email)|raw }}E-Mail</a>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
        {% if app.request.attributes.get('_scope') == 'backend' %}
            {% for member in members %}
                {% if member.name|default %}
                    <h4 class="mt-0 text-primary">{{ member.name }}</h4>
                {% endif %}
                {% if member.image|default %}
                    <div style="margin-bottom: 15px;">
                        {{ insert_tag("{{image::" ~ member.image ~ "?width=100&height=100&method=crop}}") }}
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div><!-- end row -->
</div>
