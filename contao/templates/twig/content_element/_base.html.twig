{% extends "@Contao/content_element/_base.html.twig" %}

{# Append the marginTop and marginBottom classes to the class attribute of every content element #}
{% set attributes = attributes|default(attrs())
    .addClass([data.marginTop|default(''), data.marginBottom|default('')]) %}

{# Append the data-anchorlink attribute to every content element #}
{% if data.anchorLink|default('') != '' %}
    {% set attributes = attributes
        .set('data-anchorlink', data.anchorLink)
        .set('id', data.anchorLink) %}
{% endif %}
