{% extends "@Contao/content_element/_base.html.twig" %}

{% set attributes = attributes|default(attrs())
    .set('id', 'anchorLinks')
%}

{% block content %}
    {% set rand_id = '' %}{% for i in 1..8 %}{% set rand_id = rand_id ~ random('abcdefghijklmnopqrstuvwxyz') %}{% endfor %}
    <div class="anchor-links d-md-block block" id="{{ rand_id }}">
        <ul></ul>
    </div>
    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
        document.addEventListener('DOMContentLoaded', function () {
            const anchorLinkContext = '{{ anchor_link_context }}';
            const request = '{{ insert_tag('env::request') }}';

            if (!anchorLinkContext) {
                return;
            }

            const targets = document.querySelectorAll('[data-anchorlink]');
            const element = document.getElementById('{{ rand_id }}');
            const list = document.querySelector('#{{ rand_id }} ul');

            for (const target of targets) {
                const id = target.getAttribute('data-anchorlink');

                if (!id || id === '') {
                    continue;
                }

                element.classList.remove('d-none');

                icon = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16"><path fill="currentColor" fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8"/></svg>';

                const listEl = `<li><a class="js-scroll-trigger d-flex flex-nowrap align-items-center" href="${request}#${id}">${icon} <span class="ms-1">${id}</span></a></li>`;
                list.insertAdjacentHTML('beforeend', listEl);
            }
        });
    </script>
{% endblock %}
