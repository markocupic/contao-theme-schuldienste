{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}
    <div class="d-block">
        {% block google_maps %}
            {% set iframe_attributes = attrs()
                .setIfExists('title',title|default)
                .set('width',width|default('100%'))
                .set('height',height|default('300'))
                .set('frameborder',frameborder|default('0'))
                .set('scrolling',scrolling|default('no'))
                .set('marginheight',marginheight|default('0'))
                .set('marginwidth',marginwidth|default('0'))
                .set('src',src|default(''))
                .mergeWith(iframe_attributes|default) %}
            <iframe{% block iframe_attributes %}{{ iframe_attributes }}{% endblock %}></iframe>
        {% endblock %}
    </div>
{% endblock %}

