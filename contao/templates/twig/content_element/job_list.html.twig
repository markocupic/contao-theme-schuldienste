{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}
{# Downloads #}
{% use "@Contao/component/_list.html.twig" %}
{% use "@Contao/component/_download.html.twig" %}

{% block content %}
    <ul class="job-list--list grid">
        {% for job in jobs %}
            <li class="job-list--list-item g-col-12 g-col-md-6 mt-3 mb-3">
                <div class="job-list--title">
                    <h3>{{ job.title }}</h3>
                </div>
                <div class="job-list--description">
                    {{ job.description }}
                </div>
                {% if job.figure|default %}
                    <div class="job-list--image">
                        {% with {figure: job.figure} %}{{ block('figure_component') }}{% endwith %}
                    </div>
                {% endif %}
                <div class="job-list--enclosures">
                    {% if job.addEnclosure|default %}
                        {% with job %}{{ block('list_component') }}{% endwith %}
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ul>
{% endblock %}

{% block list_item_attributes %}
    {{- attrs(list.item_attributes|default).addClass(['download-element', "ext-#{item.file.extension(true)}"]) -}}
{% endblock %}

{% block list_item %}
    {% with {download: item} %}{{ block('download_component') }}{% endwith %}
{% endblock %}
