{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}
{# Downloads #}
{% use "@Contao/component/_list.html.twig" %}
{% use "@Contao/component/_download.html.twig" %}

{% block content %}
    <ul class="job-list--list grid">
        {% for job in jobs %}
            <li class="job-list--list-item g-col-12 g-col-md-6">
                <div class="job-list--title">
                    <h5>{{ job.title }}</h5>
                    {# Trigger Bootstrap modal #}
                    <button type="button" class="btn btn-sm btn-primary " data-bs-toggle="modal" data-bs-target="#jobModal{{ job.id }}">
                        interessiert?
                    </button>
                </div>
                {# Bootstrap modal #}
                <div class="modal fade" id="jobModal{{ job.id }}" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-fullscreen-sm-down">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="exampleModalLabel{{ job.id }}">Werde Teil unseres Teams</h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="job-list--title">
                                    <h3>{{ job.title }}</h3>
                                </div>
                                <div class="job-list--description mt-4">
                                    {{ job.description }}
                                </div>
                                {% if job.figure|default %}
                                    <div class="job-list--image mt-4">
                                        {% with {figure: job.figure} %}{{ block('figure_component') }}{% endwith %}
                                    </div>
                                {% endif %}
                                <div class="job-list--enclosures mt-4">
                                    {% if job.addEnclosure|default %}
                                        {% with job %}{{ block('list_component') }}{% endwith %}
                                    {% endif %}
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Schliessen</button>
                            </div>
                        </div>
                    </div>
                </div>
                {# End modal #}
            </li>
        {% endfor %}
    </ul>
{% endblock %}

{% block list_item_attributes %}
    {{- attrs(list.item_attributes|default).addClass(['download-element', "ext-#{item.file.extension(true)}"]) -}}
{% endblock %}

{% block list_item %}
    {% with {download: item} %}{{ block('download_component') }}{% endwith %}
{% endblock %}
