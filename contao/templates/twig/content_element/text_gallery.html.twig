{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}
{% use '@Contao/component/_rich_text.html.twig' %}

{% set attributes = attributes|default(attrs())
    .addClass(text_box_bg_classes)
    .mergeWith(attributes|default) %}

{% block content %}
    <div class="inner">
        <div class="row g-0">
            <div class="col-12 col-md-6 col-lg-7">
                <div class="content-text-gallery__col-text">
                    {# Richtext #}
                    {% block text %}
                        {% with {text, attributes: text_attributes|default} %}{{ block('rich_text_component') }}{% endwith %}
                    {% endblock %}
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-5">
                <div class="js-fader-gallery content-text-gallery__col-gallery">
                    {% if images|default %}
                        <ul>
                            {% for image in images %}
                                <li>
                                    {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% add to body %}
        <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
            document.addEventListener('DOMContentLoaded', () => {

                const galleries = document.querySelectorAll('.content-text-gallery .js-fader-gallery');

                for (const gallery of galleries) {
                    if (gallery.classList.contains('js-fader-gallery__initialized')) {
                        continue;
                    }

                    gallery.classList.add('js-fader-gallery__initialized');

                    const images = gallery.querySelectorAll('img');

                    if (images) {
                        images[0].classList.add('active');
                        let index = 0;

                        setInterval(() => {
                            images[index].classList.remove('active');
                            index = (index + 1) % images.length;
                            images[index].classList.add('active');
                        }, 5000);
                    }
                }
            });
        </script>
    {% endadd %}
    {% add to head %}
        <style{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
            .content-text-gallery {
                .content-text-gallery__col-text, .content-text-gallery__col-gallery {
                    margin-bottom: 0;
                    overflow: hidden;
                }
            }

            .content-text-gallery .js-fader-gallery ul {
                list-style-type: none;
                padding: 0;
                position: relative;
                overflow: hidden;
                width: 100%;
                height: 100%;
                min-height: 300px;
                margin: 0;
            }

            .content-text-gallery .js-fader-gallery {
                height: 100%;
                width: 100%;
            }

            .content-text-gallery .js-fader-gallery img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                opacity: 0;
                transition: opacity 2s ease;
            }

            .content-text-gallery .js-fader-gallery img.active {
                opacity: 1;
            }
        </style>
    {% endadd %}
{% endblock %}
