{%- set rootAttributes = attrs()
    .set('lang', language)
    .set('dir', 'rtl', isRTL)
    .mergeWith(rootAttributes|default) -%}

{%- set bodyAttributes = attrs()
    .set('id', 'top')
    .addClass(class)
    .setIfExists('onload', onload)
    .mergeWith(bodyAttributes|default) -%}
<!DOCTYPE html>
<html{{ rootAttributes }}>
<head>

    {% block head %}
        <meta charset="{{ charset }}">
        <title>{{ title }}</title>
        <base href="{{ base }}">

        {% block meta %}
            <meta name="robots" content="{{ robots }}">
            <meta name="description" content="{{ description|u.truncate(320, '…') }}">
            <meta name="generator" content="Contao Open Source CMS">
            {% for metaTag in metaTags|default %}
                <meta{{ metaTag }}>
            {% endfor %}
            {% for linkTag in linkTags|default %}
                <meta{{ linkTag }}>
            {% endfor %}
        {% endblock %}

        {% if canonical|default %}
            <link rel="canonical" href="{{ canonical }}">
        {% endif %}

        {{ viewport|raw }}
        {{ framework|raw }}
        {{ stylesheets|raw }}
        {{ mooScripts|raw }}
        {{ head|insert_tag_raw|raw }}
    {% endblock %}

</head>
<body{{ bodyAttributes }}>

{% block body %}
    {{ contao_sections('top') }}

    <div id="wrapper" class="layout-wrapper container-xl">
        {% block header %}
            {% if header %}
                <header id="header">
                    <div class="inside">
                        {{ header|raw }}
                    </div>
                </header>
            {% endif %}
        {% endblock %}

        {{ contao_sections('before') }}

        {% block container %}
            <div id="container" class="layout-container row gx-0">

                {% block main %}
                    <main id="main" class="layout-main col-12 col-lg-9 order-2">
                        <div class="inside">
                            {{ main|raw }}
                        </div>
                        {{ contao_sections('main') }}
                    </main>
                {% endblock %}

                {% block left %}
                    {% if left %}
                        <aside id="left" class="layout-left d-none d-lg-block col-12 col-lg-3 order-1">
                            <div class="inside sticky-lg-top">
                                <div class="d-none d-lg-block mb-3 img-profile-container">
                                    <a href="{{ insert_tag('env::url') }}">
                                        {# Logo Schuldienste Kreis Dagmersellen #}
                                        {{ include('@MarkocupicContaoSchuldiensteTheme/component/frontend/brand_logo.html.twig') }}
                                    </a>
                                </div>
                                {{ left|raw }}
                            </div>
                        </aside>
                    {% endif %}
                {% endblock %}

                {% block right %}
                    {% if right %}
                        <aside id="right" class="layout-right">
                            <div class="inside">
                                {{ right|raw }}
                            </div>
                        </aside>
                    {% endif %}
                {% endblock %}

            </div>
        {% endblock %}

        {% block footer %}
            {% if footer %}
                <footer id="footer" class="layout-footer">
                    <div class="inside">
                        {{ footer|raw }}
                    </div>
                </footer>
            {% endif %}
        {% endblock %}

        {{ contao_sections('after') }}

    </div>

    {{ contao_sections('bottom') }}
{% endblock %}

{{ mootools|raw }}
{{ jsonLdScripts|raw }}

</body>
</html>
