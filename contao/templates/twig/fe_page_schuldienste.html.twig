{%- set rootAttributes = attrs()
    .set('lang', language)
    .set('dir', 'rtl', isRTL)
    .mergeWith(rootAttributes|default) -%}

{%- set bodyAttributes = attrs()
    .set('id', 'top')
    .addClass(class)
    .setIfExists('onload', onload)
    .mergeWith(bodyAttributes|default) -%}
<!DOCTYPE html>
<html{{ rootAttributes }}>
<head>

    {% block head %}
        <meta charset="{{ charset }}">
        <title>{{ title }}</title>
        <base href="{{ base }}">

    {% block meta %}
    <meta name="robots" content="{{ robots }}">
    <meta name="description" content="{{ description|u.truncate(320, '…') }}">
    <meta name="generator" content="Contao Open Source CMS">
        {% for metaTag in metaTags|default %}
    <meta{{ metaTag }}>
        {% endfor %}
        {% for linkTag in linkTags|default %}
    <meta{{ linkTag }}>
        {% endfor %}
    {% endblock %}

        {% if canonical|default %}
    <link rel="canonical" href="{{ canonical }}">
        {% endif %}

        {# --- Add favicons --- #}
        {{ include('@MarkocupicContaoSchuldiensteTheme/favicon.html.twig') }}
        {# --- Add Google Fonts --- #}
        {{ include('@MarkocupicContaoSchuldiensteTheme/google_fonts.html.twig') }}
        {# --- Add Fontawesome --- #}
        <link rel="stylesheet" href="assets/contao-component-fontawesome-free/fontawesomefree/css/all.css">
        {# --- Add Theme scripts --- #}
        <script src="{{ asset('js/theme.js', 'markocupic_contao_schuldienste_theme') }}"></script>
        {# --- Add the theme styles --- #}
        <link rel="stylesheet" href="{{ asset('styles/frontend.css', 'markocupic_contao_schuldienste_theme') }}">

        {{ viewport|raw }}
        {{ framework|raw }}
        {{ stylesheets|raw }}
        {{ mooScripts|raw }}
        {{ head|insert_tag_raw|raw }}
    {% endblock %}

</head>
<body{{ bodyAttributes }}>

{% block body %}
    {{ contao_sections('top') }}

    <div id="wrapper" class="layout-wrapper container-xl">
        {% block header %}
            <header id="header" class="layout-header">
                <div class="inside">
                    {{ include('@MarkocupicContaoSchuldiensteTheme/layout_header.html.twig')|raw }}
                </div>
            </header>
        {% endblock %}

        {{ contao_sections('before') }}

        {% block container %}
            <div id="container" class="layout-container">

                {% block main %}
                    <main id="main" class="layout-main">
                        <div class="inside">
                            {{ main|raw }}
                        </div>
                        {{ contao_sections('main') }}
                    </main>
                {% endblock %}

                {% block left %}
                    <aside id="left" class="layout-left fixed-top">
                        <div class="inside ">
                            {{ include('@MarkocupicContaoSchuldiensteTheme/layout_left.html.twig')|raw }}
                            {{ left|raw }}
                        </div>
                    </aside>
                {% endblock %}

                {% block right %}
                    {% if right %}
                        <aside id="right" class="layout-right">
                            <div class="inside">
                                {{ right|raw }}
                            </div>
                        </aside>
                    {% endif %}
                {% endblock %}

            </div>
        {% endblock %}

        {% block footer %}
            {% if footer %}
                <footer id="footer" class="layout-footer">
                    <div class="inside">
                        {{ footer|raw }}
                    </div>
                </footer>
            {% endif %}
        {% endblock %}

        {{ contao_sections('after') }}

    </div>

    {{ contao_sections('bottom') }}
{% endblock %}

{{ mootools|raw }}
{{ jsonLdScripts|raw }}
{# --- Add Bootstrap --- #}
<script src="{{ asset('bootstrap/dist/js/bootstrap.bundle.min.js', 'markocupic_contao_schuldienste_theme') }}"></script>
</body>
</html>
