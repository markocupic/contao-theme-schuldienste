{% extends '@Contao/block_unsearchable.html.twig' %}

{% block content %}
    {% add to head %}
        <style{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
            .search-bar {
                background-color: var(--bs-body-bg);

                &:hover {
                    background-color: transparent;
                }

                [type="search"] {
                    background-color: transparent;
                    border: 0;
                    padding-left: 2rem;

                    &:focus {
                        box-shadow: none;
                    }
                }

                [type="submit"] {
                    background-color: var(--bs-primary);
                    border: 0;
                    margin: .5rem;
                    height: 2.5rem;
                    width: 2.5rem;
                    color: #fff;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }
            }

            .search-bar:has([type="search"]:focus) {
                border: 3px solid rgba(253, 107, 34, .25) !important;
            }

        </style>
    {% endadd %}

    <form{% if action|default %} action="{{ action }}"{% endif %} method="get">
        <div class="formbody">
            <span class="widget widget-text mb-3">
                <div class="search-bar w-100 d-flex border rounded-pill">
                    <input type="search" name="keywords" class="form-control" id="ctrl_keywords_{{ uniqueId }}" placeholder="Wonach suchen Sie?" value="{{ keyword }}" spellcheck="false" aria-label="Suche" aria-describedby="ctrl_submit_{{ uniqueId }}">
                    {# <button class="btn btn-primary" type="submit" id="ctrl_submit_{{ uniqueId }}"><i class="fa fa-search"></i></button> #}
                    {# <label for="ctrl_keywords_{{ uniqueId }}">{{ keywordLabel }}</label> #}
                     <button type="submit" id="ctrl_submit_{{ uniqueId }}" class="btn rounded-circle submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" role="img" aria-hidden="true" class="icon ">
                            <path d="M21 21L16.65 16.65M19 11C19 15.4183 15.4183 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </button>
                </div>
            </span>
        </div>

        {% if advanced %}
            <div class="widget widget-radio mt-5 mb-5">
                <fieldset class="radio_container">
                    <legend class="invisible">{{ optionsLabel }}</legend>
                    <span><input type="radio" name="query_type" id="matchAll_{{ uniqueId }}" class="radio" value="and"{% if 'and' == queryType %} checked{% endif %}> <label for="matchAll_{{ uniqueId }}">{{ matchAll }}</label></span>
                    <span><input type="radio" name="query_type" id="matchAny_{{ uniqueId }}" class="radio" value="or"{% if 'or' == queryType %} checked{% endif %}> <label for="matchAny_{{ uniqueId }}">{{ matchAny }}</label></span>
                </fieldset>
            </div>
        {% endif %}
    </form>
    {% if header|default %}
        <p class="header">{{ header|raw }}</p>
        {% if keywordHint|default %}
            <p class="info">{{ keywordHint }}</p>
        {% endif %}
    {% endif %}

    {{ results|raw }}
    {{ pagination|raw }}

{% endblock %}
