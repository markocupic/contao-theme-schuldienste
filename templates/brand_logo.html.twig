<div class="brand-logo">
    <div class="brand-logo--light-theme">
        {{ insert_tag('image::files/themes/schuldienste-theme/img/logos/logo_spd_text_2025.svg?alt=Schuldienste Kreis Dagmersellen')|raw }}
    </div>
    <div class="brand-logo--dark-theme">
        {{ insert_tag('image::files/themes/schuldienste-theme/img/logos/logo_spd_text_2025_dark_theme.svg?alt=Schuldienste Kreis Dagmersellen')|raw }}
    </div>
</div>

{% add to head %}
    <style>
        html .brand-logo .brand-logo--dark-theme {
            display: none;
        }

        html[data-bs-theme="dark"] .brand-logo .brand-logo--dark-theme {
            display: block;
        }

        html[data-bs-theme="dark"] .brand-logo .brand-logo--light-theme {
            display: none;
        }
    </style>
{% endadd %}
