{% set ctx = _context.card is defined ? _context.card : _context %}

{% block address_card_component %}
    <div class="address-card card border-0">
        <div class="address-card__body card-body">
            <div class="address-card__icon">
                {% if ctx.url|default %}<a href="{{ insert_tag(ctx.url|replace({'{{': '', '}}': ''})) }}">{% endif %}
                    <div class="address-card__icon-inner">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-sign-turn-right" viewBox="0 0 16 16">
                            <path d="M5 8.5A2.5 2.5 0 0 1 7.5 6H9V4.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L9.41 8.658A.25.25 0 0 1 9 8.466V7H7.5A1.5 1.5 0 0 0 6 8.5V11H5z"/>
                            <path fill-rule="evenodd" d="M6.95.435c.58-.58 1.52-.58 2.1 0l6.515 6.516c.58.58.58 1.519 0 2.098L9.05 15.565c-.58.58-1.519.58-2.098 0L.435 9.05a1.48 1.48 0 0 1 0-2.098zm1.4.7a.495.495 0 0 0-.7 0L1.134 7.65a.495.495 0 0 0 0 .7l6.516 6.516a.495.495 0 0 0 .7 0l6.516-6.516a.495.495 0 0 0 0-.7L8.35 1.134Z"/>
                        </svg>
                    </div>
                    {% if ctx.url|default %}</a>{% endif %}
            </div>

            <address class="mb-3">
                {% if ctx.name|default %}
                    <div class="address-card__title card-title mb-3">
                        {% if ctx.url|default %}<a href="{{ insert_tag(ctx.url|replace({'{{': '', '}}': ''})) }}">{% endif %}
                            <strong>{{ ctx.name }}</strong>
                            {% if ctx.url|default %}</a>{% endif %}
                    </div>
                {% endif %}

                {% if ctx.function|default %}
                    <div class="address-card__postalandcity">
                        <span class="text-muted mb-2 text-body-secondary">{{ ctx.function }}</span>
                    </div>
                {% endif %}

                {% if ctx.street|default %}
                    <div class="address-card__street"><span>{{ ctx.street }}</span></div>
                {% endif %}

                <div class="address-card__postalandcity">
                    <span>{{ ctx.postal|default }}</span> <span>{{ ctx.city|default }}</span>
                </div>

                {% if ctx.phone|default %}
                    <div class="address-card__phone">
                        <a class="card-link" href="tel:{{ ctx.phone|replace([' ', '']) }}">{{ ctx.phone }}</a>
                    </div>
                {% endif %}

                {% if ctx.email|default %}
                    <div class="address-card__email">{{ insert_tag('email::'~ctx.email)|raw }}</div>
                {% endif %}
            </address>
        </div>
    </div>
{% endblock %}
