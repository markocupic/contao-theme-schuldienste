<!-- Theme toggle -->
<button type="button" class="theme-toggle__button btn-unstyled d-inline-flex align-items-center p-0" aria-label="Toggle dark mode">
    <span class="theme-toggle__icon--light-theme badge rounded-pill text-bg-dark ms-2 label" title="Helles Layout aktivieren"><i class="fa-regular fa-sun"></i><span class="pill-links__label">Hell</span></span>
    <span class="theme-toggle__icon--dark-theme badge rounded-pill text-bg-dark ms-2 label" title="Dunkles Layout aktivieren"><i class="fa-regular fa-moon"></i><span class="pill-links__label">Dunkel</span></span>
</button>

{% add to body %}
    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
        // Key for localStorage
        const THEME_KEY = 'bs-theme';

        // Detect system preference
        const getPreferredTheme = () => {
            const stored = localStorage.getItem(THEME_KEY);
            if (stored === 'light' || stored === 'dark') return stored;

            // Check browser preference if no stored value
            return window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
        };

        const setTheme = (theme) => {
            document.documentElement.setAttribute('data-bs-theme', theme);
            localStorage.setItem(THEME_KEY, theme);
        };

        // Init on load
        const initTheme = () => {
            setTheme(getPreferredTheme());

            const buttons = document.querySelectorAll('.theme-toggle__button');
            if (!buttons) return;

            for (const btn of buttons) {
                btn.addEventListener('click', () => {
                    const current = document.documentElement.getAttribute('data-bs-theme') || 'light';
                    const next = current === 'light' ? 'dark' : 'light';
                    setTheme(next);
                });
            }

            // Optional: react to system changes if user has no explicit choice
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                const stored = localStorage.getItem(THEME_KEY);
                if (stored !== 'light' && stored !== 'dark') {
                    setTheme(e.matches ? 'dark' : 'light');
                }
            });
        };

        document.addEventListener('DOMContentLoaded', initTheme);
    </script>
{% endadd %}
<style>
    button.theme-toggle__button:hover, button.theme-toggle__button:active {
        color: var(--bs-body-color) !important;
    }

    html .theme-toggle__icon--light-theme {
        display: none !important;
    }

    html[data-bs-theme="dark"] .theme-toggle__icon--light-theme {
        display: flex !important;
    }

    html[data-bs-theme="dark"] .theme-toggle__icon--dark-theme {
        display: none !important;
    }
</style>
