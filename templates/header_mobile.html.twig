<div class="mobile-navigation" id="mobileNavigation">
    <button class="mobile-navigation-toggler" type="button" aria-controls="navbarMobile" aria-expanded="false" aria-label="Toggle mobile navigation">
        <i class="fa-2x fa-solid fa-bars nav-open"></i>
        <i class="fa-2x fa-solid fa-xmark nav-close"></i>
    </button>
    <a class="" href="{{ insert_tag('env::url') }}">
        <div class="mobile-navigation__logo-box">
            <a href="{{ insert_tag('env::url') }}" title="Schuldienste Dagmersellen">
                {# Logo Schuldienste Kreis Dagmersellen #}
                {{ include('@MarkocupicContaoSchuldiensteTheme/component/frontend/brand_logo.html.twig') }}
            </a>
        </div>
    </a>
    {{ insert_tag('insert_module::1')|raw }}
    <div class="mt-5">
        {% include('@MarkocupicContaoSchuldiensteTheme/component/frontend/theme_toggle.html.twig') %}
    </div>
</div>

{% add to body %}
    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
        const body = document.querySelector('body');
        const buttons = document.querySelectorAll('.mobile-navigation-toggler');

        // Always set the aria-expanded attribute to the current state of the body
        const observer = new MutationObserver(() => {
            const expanded = body.classList.contains('mobile-navigation-active');
            buttons.forEach(btn => btn.setAttribute('aria-expanded', expanded));
        });

        observer.observe(body, {
            attributes: true,
            attributeFilter: ['class']
        });

        for (const button of buttons) {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                button.disabled = true;
                setTimeout(() => {
                    button.disabled = false;
                }, 1000);

                body.classList.toggle('mobile-navigation-active');

            });
        }
    </script>
{% endadd %}
