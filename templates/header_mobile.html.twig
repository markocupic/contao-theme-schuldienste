<!-- Here comes the bootstrap navbar -->
<nav class="header-mobile bg-white d-lg-none" id="headerMobile">
    <div class="header-mobile--inner d-block">
        <div class="d-flex justify-content-between">
            <div>
                <a class="" href="{{ insert_tag('env::url') }}">
                    <div class="header-logo-box">
                        <a href="{{ insert_tag('env::url') }}" title="Schuldienste Dagmersellen">
                            <img src="files/themes/schuldienste-theme/img/logos/logo_spd_text_2025.svg" class="logo-header-mobile" alt="Logo Schuldienste Dagmersellen">
                        </a>
                    </div>
                </a>
            </div>
            <div>
                <button class="mobile-navigation-toggler" type="button" aria-controls="navbarMobile" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa-2x fa-solid fa-bars nav-open"></i>
                    <i class="fa-2x fa-solid fa-xmark nav-close"></i>
                </button>
            </div>
        </div>
    </div>
</nav>

<div class="mobile-navigation" id="mobileNavigation">
        <button class="mobile-navigation-toggler" type="button" aria-controls="navbarMobile" aria-expanded="false" aria-label="Toggle navigation">
            <i class="fa-2x fa-solid fa-bars nav-open"></i>
            <i class="fa-2x fa-solid fa-xmark nav-close"></i>
        </button>
        <a class="" href="{{ insert_tag('env::url') }}">
            <div class="header-logo-box">
                <a href="{{ insert_tag('env::url') }}" title="Schuldienste Dagmersellen">
                    <img src="files/themes/schuldienste-theme/img/logos/logo_spd_text_2025.svg" class="logo-header-mobile" alt="Logo Schuldienste Dagmersellen">
                </a>
            </div>
        </a>
    {{ insert_tag('insert_module::1')|raw }}
</div>

<script>
    const body = document.querySelector('body');

    const buttons = document.querySelectorAll('.mobile-navigation-toggler');

    for (const button of buttons) {
        button.addEventListener('click', (e) => {
            button.disabled = true;
            setTimeout(() => {
                button.disabled = false;
            }, 2000);

            body.classList.toggle('mobile-navigation-active');
        });
    }
</script>
<!-- end navbar -->
