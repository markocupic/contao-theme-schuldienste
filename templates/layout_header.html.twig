<script>
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('[data-search-toggle]');

        // Always set the aria-expanded attribute to the current state of the body
        const observer = new MutationObserver(() => {
            const expanded = body.classList.contains('search-bar-expanded');
            buttons.forEach(btn => btn.setAttribute('aria-expanded', expanded));
        });

        observer.observe(body, {
            attributes: true,
            attributeFilter: ['class']
        });

        buttons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                document.body.classList.toggle('search-bar-expanded');
            });
        });
    });
</script>
{% add to body %}
    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
        const body = document.querySelector('body');
        const buttons = document.querySelectorAll('.navigation-toggle');

        // Always set the aria-expanded attribute to the current state of the body
        const observer = new MutationObserver(() => {
            const expanded = body.classList.contains('navigation-active');
            buttons.forEach(btn => btn.setAttribute('aria-expanded', expanded));
        });

        observer.observe(body, {
            attributes: true,
            attributeFilter: ['class']
        });

        for (const button of buttons) {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                button.disabled = true;
                setTimeout(() => {
                    button.disabled = false;
                }, 400);

                body.classList.toggle('navigation-active');
            });
        }
    </script>
{% endadd %}
